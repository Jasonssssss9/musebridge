    {
      "chunk_id": "getty-103rgh-description-01",
      "artwork_id": "getty-103rgh",
      "source_id": "getty-103rgh-record",
      "source_locator": "Object description, paragraph 1 (Setting and color)",
      "excerpt": "This night landscape represents the coastline at Åsgårdstrand, a small beach resort south of Oslo in Norway, where Edvard Munch spent his summers from the 1880s onward. Here Munch tried to capture the emotions called forth by the night rather than to record its picturesque qualities. The color blue conveys the mysticism and melancholy of the landscape, which seems full of premonitions.",
      "license": "CC-BY-4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "J. Paul Getty Museum",
      "normalization": "HTML removed; whitespace normalized.",
      "topics": [
        "setting",
        "color",
        "mood"
      ]
    },
    {
      "chunk_id": "getty-103rgh-description-02",
      "artwork_id": "getty-103rgh",
      "source_id": "getty-103rgh-record",
      "source_locator": "Object description, paragraph 1 (The fence and shadow)",
      "excerpt": "An abstract mound at the right represents a clump of trees; a white fence runs diagonally in front. The vaguely defined shape on the fence may be a shadow of two lovers, a recurring theme in Munch's work.",
      "license": "CC-BY-4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "J. Paul Getty Museum",
      "normalization": "HTML removed; whitespace normalized.",
      "topics": [
        "fence",
        "shadow",
        "interpretation"
      ]
    },
    {
      "chunk_id": "getty-103rgh-description-03",
      "artwork_id": "getty-103rgh",
      "source_id": "getty-103rgh-record",
      "source_locator": "Object description, paragraph 1 (The shoreline and reflections)",
      "excerpt": "He used an undulating line to depict the shoreline that continues into the trees at the right. Stars reflect in the water, and a flash of light in the trees shines brightly.",
      "license": "CC-BY-4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "J. Paul Getty Museum",
      "normalization": "HTML removed; whitespace normalized.",
      "topics": [
        "composition",
        "shoreline",
        "light"
      ]
    },
    {
      "chunk_id": "getty-103rgh-description-04",
      "artwork_id": "getty-103rgh",
      "source_id": "getty-103rgh-record",
      "source_locator": "Object description, paragraph 2 (Painting the sky)",
      "excerpt": "Varying thicknesses of blue and green paint are blended together to form the impression of a night sky. Some areas are thickly painted, while others are left bare to convey the lighter segments of the sky or a celestial phenomenon.",
      "license": "CC-BY-4.0",
      "license_url": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "J. Paul Getty Museum",
      "normalization": "HTML removed; whitespace normalized.",
      "topics": [
        "brushwork",
        "color",
        "surface",
        "sky"
      ]
    },
    {
      "chunk_id": "getty-103rgh-guide-01",
      "artwork_id": "getty-103rgh",
      "source_id": "musebridge-103rgh-guide",
      "source_locator": "MuseBridge guide note 1",
      "excerpt": "Start with the pale fence and follow its diagonal toward the trees. Then find the shoreline and trace its curve. Which line carries your eye farther into the scene?",
