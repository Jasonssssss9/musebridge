# Native development profile. Run the server from the api directory.
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
DATASET_VERSION=aic-seed-v0.1
SEED_PATH=../knowledge/data/aic-seed-v0.1.json
RETRIEVAL_BASE_URL=http://127.0.0.1:8001
GENERATION_MODE=fixture
# Opt in to agent-demo-v0.3: set GENERATION_MODE=agent and privately supply
# AGENT_SERVICE_TOKEN, matching the private FastAPI service. Never commit it.
# AGENT_BASE_URL=http://127.0.0.1:8002
